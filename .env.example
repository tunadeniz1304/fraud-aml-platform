# LLM analysis provider. Supported: openai | anthropic | none
# "none" disables LLM calls (RAG + rule engine still run) — real providers only.
LLM_PROVIDER=none

# --- OpenAI (used when LLM_PROVIDER=openai) -------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
