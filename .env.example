# Anil3 — örnek ortam değişkenleri. Kopyalayın: cp .env.example .env
# Değerleri BOŞ bırakırsanız sistem güvenli varsayılanlarla (LLM demo modu) çalışır.
# .env ASLA commit edilmez; Docker'a env_file ile verilir.

# --- LLM (tak-çalıştır: anahtar varsa CANLI, yoksa DEMO) ---------------------
# Anahtar takma adları (ilk dolu olan kazanır): LLM_API_KEY, DEEPSEEK_API_KEY,
# OPENAI_API_KEY
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# auto | live | demo
LLM_MODE=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
# Opsiyonel Anthropic yolu (LLM_PROVIDER=anthropic)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Güvenlik ---------------------------------------------------------------
# dev | test | prod — prod'da güvensiz varsayılanlarla başlatma reddedilir.
# docker compose ve Docker imajı boşsa prod kullanır; yerel demo için dev verin
# (ENVIRONMENT=dev SEED_DEMO_USERS=true docker compose up --build).
# Prod'da zorunlu: JWT_SECRET, AUDIT_HMAC_KEY, CONSORTIUM_SALT (veya
# CONSORTIUM_ENABLED=false), redis:// RATE_LIMIT_STORAGE_URI; tanımlanan
# ADMIN_TOKEN / SERVICE_API_KEY / SERVICE_HMAC_SECRET en az 32 rastgele karakter.
ENVIRONMENT=
# JWT imza anahtarı (en az 32 karakter). Yerelde boşsa süreç ömürlü geçici
# anahtar üretilir; prod, docker compose ve WEB_CONCURRENCY>1 için ZORUNLU.
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# uvicorn worker sayısı (>1 ise JWT_SECRET ve REDIS_URL zorunlu)
WEB_CONCURRENCY=
# Konsorsiyum tuzu: üyeler arası paylaşılan gizli değer; prod'da demo tuzu
# reddedilir, docker compose için ZORUNLU (üretimi JWT_SECRET ile aynı)
CONSORTIUM_SALT=
# Break-glass yönetici token'ı (opsiyonel; prod'da tanımlıysa >= 32 karakter)
ADMIN_TOKEN=
# POST /api/transactions için servis kimlikleri (X-API-Key veya HMAC imzası)
SERVICE_API_KEY=
SERVICE_HMAC_SECRET=
# Denetim zinciri HMAC anahtarı (>= 32 karakter; ilk çalıştırmadan önce verin).
# Prod ve docker compose için ZORUNLU; üretimi JWT_SECRET ile aynı.
AUDIT_HMAC_KEY=
# Demo kullanıcı parolalarını değiştirmek için
DEMO_PW_ANALIST=
DEMO_PW_KIDEMLI=
DEMO_PW_ADMIN=
# JSON liste, ör. ["http://localhost:5173"]
CORS_ORIGINS=

# --- Çalışma zamanı -----------------------------------------------------------
# batch | stream | off
STREAM_MODE=
STREAM_RATE=
LOG_LEVEL=
LOG_JSON=
API_DOCS=
# chroma | off  /  onnx | hash
VECTOR_STORE=
VECTOR_EMBEDDING=

# /metrics bearer token (empty -> /metrics answers 404; METRICS_PUBLIC=true opens it)
METRICS_TOKEN=
# Demo kullanıcıları: tanımsızsa prod dışında açık (docker compose'da kapalı,
# SEED_DEMO_USERS=true ile açılır); prod'da her zaman reddedilir
SEED_DEMO_USERS=
